# Install necessary packages (if you haven't already)
# install.packages(c("GEOquery", "data.table"))
# Load required libraries
library(data.table)
library(DESeq2)
library(pheatmap)
library(ggplot2)
# Step 1: Read the count data and metadata
# Read the count data (assumed format for this example)
counts <- fread("GSE134697_CountMatrix.tsv")
full_counts <- read.delim("GSE134697_CountMatrix.tsv", skip = 1, header = TRUE)
# Dropping unnecessary columns (assuming first 6 columns are metadata and rest are counts)
count_data <- full_counts[, 7:ncol(full_counts)]
# Read the metadata file
metadata <- read.csv("GSE134697_metadata.csv", row.names = 1)
coldata <- metadata[, (ncol(metadata)-2):ncol(metadata)]  # selecting the last two columns as condition and tissue info
colnames(count_data) <- rownames(coldata)
# Ensure that the condition and tissue columns are factors
coldata$condition <- factor(coldata$condition.ch1, levels = c("without epilepsy", "mesial temporal lobe epilepsy"))
coldata$tissue <- factor(coldata$tissue.ch1, levels = c("Neocortex", "Hippocampus"))
# Now create 'patient_id' from the cleaned 'individual.ch1'
n <- nrow(coldata)  # total number of samples
coldata$individual.ch1[(n-1):n] <- c("CTRL01", "CTRL02")
coldata$patient_id <- factor(coldata$individual.ch1)
# CLEANING Remove Genes with zero counts
count_data <- count_data[rowSums(count_data) > 0, ]
# Drop empty levels in 'condition' and 'tissue' columns
coldata$condition <- droplevels(coldata$condition)
coldata$tissue <- droplevels(coldata$tissue)
coldata$patient_id <- droplevels(coldata$patient_id)
#DESEq2 design
# Tissue-Specific Analysis (Neocortex Only)
#You can analyze the difference between epilepsy and control samples in Neocortex tissue only. This comparison will allow you to see how epilepsy affects gene expression in the Neocortex.
neocortex_samples <- rownames(coldata)[coldata$tissue == "Neocortex"]
dds_neocortex <- DESeqDataSetFromMatrix(
countData = count_data[, neocortex_samples],
colData = coldata[neocortex_samples, ],
design = ~ condition
)
# Run DESeq2 analysis
dds_neocortex <- dds_neocortex[rowSums(counts(dds_neocortex)) >= 10, ]
dds_neocortex <- DESeq(dds_neocortex)
res_neocortex <- results(dds_neocortex, contrast = c("condition", "mesial temporal lobe epilepsy", "without epilepsy"))
# Variance stabilizing transformation
vsd_ncort <- vst(dds_neocortex, blind = FALSE)
# Top genes
top_genes_ncort <- head(order(res_neocortex$padj), 20)
# Get significant genes
res_sig <- res_neocortex[which(res_neocortex$padj < 0.1), ]
pheatmap(assay(vsd_ncort)[top_genes_ncort, ], cluster_rows = TRUE, cluster_cols = TRUE, annotation_col = coldata)
print(top_genes_ncort)
head(top_genes_ncort)
summary(res_neocortex)
head(res_sig[order(res_sig$padj), ])  # Smallest padj values
plotDispEsts(dds_neocortex)
library(ggplot2)
# Add a column to indicate significance
res_df <- as.data.frame(res_neocortex)
res_df$gene <- rownames(res_df)
res_df$significance <- "Not Sig"
res_df$significance[res_df$padj < 0.05 & abs(res_df$log2FoldChange) > 1] <- "Significant"
#PLOT
ggplot(res_df, aes(x = log2FoldChange, y = -log10(padj), color = significance)) +
geom_point(alpha = 0.8, size = 1.5) +
scale_color_manual(values = c("gray", "red")) +
theme_minimal() +
labs(title = "Volcano Plot: Neocortex (Epilepsy vs Control)",
x = "Log2 Fold Change",
y = "-Log10 Adjusted P-value") +
theme(legend.position = "top")
# Save results to CSV
write.csv(as.data.frame(res_neocortex), "res_neocortex.csv")
# Save significant results
write.csv(subset(res_neocortex, padj < 0.05), "significant_genes_neocortex.csv")
